# Solana RPC — use mainnet for production, devnet for testing
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Minimum USDC session balance for proof-of-authorization mode (no SIGNAL_PAYMENT_WALLET set)
SIGNAL_MIN_BALANCE=0.5

# ── On-chain settlement mode ───────────────────────────────────────────────────
# Set SIGNAL_PAYMENT_WALLET to enable real USDC payment verification.
# The agent sends SIGNAL_PAYMENT_AMOUNT USDC to this address on-chain,
# then retries with X-Tally-Tx: <tx_sig>. Server verifies the transfer before
# returning the signal. Leave unset to use proof-of-authorization mode.
SIGNAL_PAYMENT_WALLET=
SIGNAL_PAYMENT_AMOUNT=0.1

# How old a payment tx can be before it's rejected as a replay (seconds).
# Must cover the full round-trip: card tap + USDC send + server polling.
# 300s (5 min) is a safe default for the full x402 flow.
SIGNAL_TX_MAX_AGE=300
